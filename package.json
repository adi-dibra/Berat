{
  "name": "berat-tab-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.dev.config.ts",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "perf": "vitest run --config vitest.perf.config.ts",
    "typecheck": "tsc --noEmit",
    "harness": "vite build --config vite.dev.config.ts && vite preview --config vite.dev.config.ts",
    "icons": "node scripts/make-icons.mjs",
    "perf:ui": "node scripts/ui-perf.mjs",
    "store-assets": "node scripts/store-assets.mjs",
    "e2e": "npm run build && node scripts/e2e-real.mjs"
  },
  "dependencies": {
    "preact": "^11.0.1",
    "tldts": "^7.4.18"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
